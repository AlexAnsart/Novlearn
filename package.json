{
  "name": "novlearn",
  "private": true,
  "description": "Scripts d'orchestration du monorepo. Les dépendances applicatives vivent dans frontend/ et duel-server/.",
  "scripts": {
    "db:push": "supabase db push",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "test": "npm run test:backend && npm run test:duel && npm run test:frontend",
    "test:backend": "cd backend && python -m pytest",
    "test:duel": "cd duel-server && npm test",
    "test:frontend": "cd frontend && npm test",
    "test:coverage": "npm run test:coverage:backend && npm run test:coverage:duel && npm run test:coverage:frontend",
    "test:coverage:backend": "cd backend && python -m pytest --cov=. --cov-report=term-missing",
    "test:coverage:duel": "cd duel-server && npm run test:coverage",
    "test:coverage:frontend": "cd frontend && npm run test:coverage",
    "db:sync:catalog": "node scripts/sync-catalog.mjs",
    "test:catalog-sync": "node --test scripts/sync-catalog.test.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "pg": "^8.23.1",
    "supabase": "^2.98.2"
  }
}
