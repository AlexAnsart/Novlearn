# Copier vers .env.catalog-sync.local (ignore par Git).
# Dashboard Supabase > Connect > Session pooler (port 5432).
# Les mots de passe des URLs doivent etre percent-encodes.
# Utiliser un role SELECT uniquement en production si possible.
CATALOG_PRODUCTION_PROJECT_REF=aaaaaaaaaaaaaaaaaaaa
CATALOG_STAGING_PROJECT_REF=bbbbbbbbbbbbbbbbbbbb
CATALOG_PRODUCTION_DB_URL=postgresql://catalog_reader.aaaaaaaaaaaaaaaaaaaa:REPLACE_ME@aws-0-eu-west-3.pooler.supabase.com:5432/postgres
CATALOG_STAGING_DB_URL=postgresql://postgres.bbbbbbbbbbbbbbbbbbbb:REPLACE_ME@aws-0-eu-west-3.pooler.supabase.com:5432/postgres
