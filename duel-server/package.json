{
  "name": "novlearn-duel-server",
  "version": "1.0.0",
  "description": "Colyseus real-time duel server for Novlearn",
  "main": "dist/app.config.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/app.config.ts",
    "build": "tsc",
    "start": "node dist/app.config.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@colyseus/ws-transport": "^0.17.0",
    "@supabase/supabase-js": "^2.39.0",
    "colyseus": "^0.17.0",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "ts-node": "^10.9.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.0",
    "vitest": "^2.1.9"
  }
}
